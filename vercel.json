{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.fantin.tech"
        }
      ],
      "destination": "https://fantin.tech/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/para/:slug/:cidade",
      "destination": "/demo"
    },
    {
      "source": "/para/:slug",
      "destination": "/demo"
    },
    {
      "source": "/:slug((?!assets|projects|hero|fonts|video|ig|gabriel|checkout|curso|demo|para|api)[a-z0-9-]+)/:cidade([a-z0-9-]+)",
      "destination": "/demo"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(hero|projects)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, stale-while-revalidate=86400"
        }
      ]
    }
  ]
}
